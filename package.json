{
  "name": "@ostro/session",
  "version": "1.0.10",
  "description": "Session module for OstroJS",
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "main": "build/sessionManager.js",
  "types": "build/sessionManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/sessionManager.d.ts",
      "default": "./build/sessionManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "dependencies": {
    "@ostro/console": "^1.0.7",
    "@ostro/contracts": "^1.0.0",
    "@ostro/cookie": "^1.0.2",
    "@ostro/support": "^1.0.2",
    "cookie": "^0.4.0",
    "cookie-signature": "^1.1.0",
    "csrf": "^3.1.0",
    "fs-extra": "^8.1.0",
    "lodash": "^4.17.21",
    "lodash.get": "^4.4.2",
    "on-headers": "^1.0.2",
    "proxy-addr": "^2.0.8",
    "uid-safe": "^2.1.5"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "session",
    "nodejs http session",
    "cookie session"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/session.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/session/issues"
  },
  "homepage": "https://github.com/ostrojs/session#readme"
}
